        <menuitem id="menu_segmentation"
                  name="Segmentation"
                  parent="menu_pricing_configuration"
                  sequence="10"/>

        <menuitem id="menu_client_groups"
                  name="Groupes de Clients"
                  parent="menu_segmentation"
                  action="action_client_segmentation_group"
                  sequence="10"/>

        <menuitem id="menu_product_groups"
                  name="Groupes de Produits"
                  parent="menu_segmentation"
                  action="action_product_pricing_group"
                  sequence="50"/>

        <!-- ===== OUTILS ===== -->
        <menuitem id="menu_pricing_tools"
                  name="Outils"
                  parent="menu_apic_pricing_root"
                  sequence="90"/>

        <menuitem id="menu_pricing_simulation"
                  name="Simulation Tarifaire"
                  parent="menu_pricing_tools"
                  action="action_pricing_simulation_wizard"
                  sequence="10"/>

        <menuitem id="menu_pricing_mass_import"
                  name="Import en Masse"
                  parent="menu_pricing_tools"
                  action="action_pricing_mass_import_wizard"
                  sequence="20"/>
    </data>
</odoo>