<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Menu Principal APIC Pricing -->
        <menuitem id="menu_apic_pricing_root"
                  name="Tarification Avancée"
                  parent="sale.sale_menu_root"
                  sequence="50"
                  groups="sales_team.group_sale_manager"/>

        <!-- Menu Configuration -->
        <menuitem id="menu_pricing_configuration"
                  name="Configuration"
                  parent="menu_apic_pricing_root"
                  sequence="100"/>

        <!-- ===== TARIFS ===== -->
        <menuitem id="menu_pricing_rules"
                  name="Règles Tarifaires"
                  parent="menu_apic_pricing_root"
                  action="action_pricing_rule"
                  sequence="10"/>

        <!-- ===== REMISES ===== -->
        <menuitem id="menu_discount_rules"
                  name="Règles de Remises"
                  parent="menu_apic_pricing_root"
                  action="action_discount_rule"
                  sequence="20"/>

        <!-- ===== PROMOTIONS ===== -->
        <menuitem id="menu_promotions"
                  name="Promotions"
                  parent="menu_apic_pricing_root"
                  action="action_pricing_promotion"
                  sequence="30"/>

        <!-- ===== EXCLUSIONS ===== -->
        <menuitem id="menu_exclusions"
                  name="Exclusions"
                  parent="menu_apic_pricing_root"
                  action="action_pricing_exclusion"
                  sequence="40"/>

