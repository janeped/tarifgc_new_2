<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulaire du wizard de simulation -->
    <record id="view_pricing_simulation_wizard_form" model="ir.ui.view">
        <field name="name">pricing.simulation.wizard.form</field>
        <field name="model">pricing.simulation.wizard</field>
        <field name="arch" type="xml">
            <form string="Simulation Tarifaire">
                <group string="Paramètres de Simulation">
                    <group>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                    </group>
                    <group>
                        <field name="order_date"/>
                        <field name="quantity"/>
                    </group>
                </group>
                
                <separator string="Résultats du Calcul" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                
                <group attrs="{'invisible': [('state', '=', 'draft')]}">
                    <group string="Tarif Appliqué">
                        <field name="base_price"/>
                        <field name="pricing_rule_code"/>
                        <field name="pricing_rule_name"/>
                        <field name="price_type"/>
                        <field name="promotion_applied"/>
                    </group>
                    <group string="Remises">
                        <field name="total_discount_percent"/>
                        <field name="discount_details"/>
                    </group>
                </group>
                
                <group class="oe_subtotal_footer oe_right" attrs="{'invisible': [('state', '=', 'draft')]}">
                    <div class="oe_subtotal_footer_separator oe_inline">Prix Final</div>
                    <field name="final_price" class="oe_subtotal_footer_separator"/>
                    <separator/>
                    <div class="oe_subtotal_footer_separator oe_inline">Total Ligne</div>
                    <field name="final_total" class="oe_subtotal_footer_separator"/>
                </group>
                
                <footer>
                    <button name="action_calculate" type="object" string="Calculer" class="btn-primary" states="draft"/>
                    <button name="action_new_simulation" type="object" string="Nouvelle Simulation" class="btn-secondary" states="calculated"/>
                    <button string="Fermer" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pricing_simulation_wizard" model="ir.actions.act_window">
        <field name="name">Simulation Tarifaire</field>
        <field name="res_model">pricing.simulation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>