<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== RÈGLE TARIFAIRE GÉNÉRALE TG ==================== -->
    
    <!-- 
        TG - Tarif Général par défaut
        S'applique à TOUS les produits et TOUS les clients
        Prix fixe: 12.50€ HT Brut (exemple - à ajuster selon tes besoins)
        Période: 01/01/2024 - 31/12/2027 (large)
        Priorité: 10 (priorité basse, donc écrasée par les règles spécifiques)
        
        Cette règle est le "filet de sécurité" qui s'applique quand aucune
        règle spécifique (produit, client, promotion) ne matche.
    -->
    <record id="tg_general_default" model="pricing.rule">
        <field name="code">TG</field>
        <field name="name">TG - Tarif Général par défaut</field>
        <field name="price_type">brut</field>
        <field name="fixed_price">12.50</field>
        <field name="priority">10</field>
        <field name="date_start">2024-01-01</field>
        <field name="date_end">2027-12-31</field>
        <field name="active">True</field>
        <!-- Pas de product_ids, customer_ids, etc. → s'applique à tous -->
    </record>

    <!-- ==================== AUTRES RÈGLES TG SPÉCIFIQUES (existantes) ==================== -->
