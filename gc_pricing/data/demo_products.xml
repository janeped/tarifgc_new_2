    <!-- Produit 1: CIRE PARAFFINE PRETE A L'EMPLOI SACHET 1 KG (réf: 133000) -->
    <!-- Tarif général évolutif + promo OLIM/BR -->
    <record id="demo_product_cire_paraffine_1kg" model="product.product">
        <field name="name">CIRE PARAFFINE PRETE A L'EMPLOI SACHET 1 KG</field>
        <field name="default_code">133000</field>
        <field name="type">product</field>
        <field name="list_price">7.76</field>
