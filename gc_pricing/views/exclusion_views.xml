<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pricing_exclusion_list" model="ir.ui.view">
        <field name="name">pricing.exclusion.list</field>
        <field name="model">pricing.exclusion</field>
        <field name="arch" type="xml">
            <list string="Exclusions">
                <field name="name"/>
                <field name="exclusion_type"/>
                <field name="priority"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pricing_exclusion_form" model="ir.ui.view">
        <field name="name">pricing.exclusion.form</field>
        <field name="model">pricing.exclusion</field>
        <field name="arch" type="xml">
            <form string="Exclusion Commerciale">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de l'exclusion"/></h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="exclusion_type"/>
                            <field name="priority"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Critères">
                            <field name="customer_ids" widget="many2many_tags"/>
                            <field name="customer_group_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pricing_exclusion" model="ir.actions.act_window">
        <field name="name">Exclusions</field>
        <field name="res_model">pricing.exclusion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
