<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pricing_traceability_wizard_form" model="ir.ui.view">
        <field name="name">pricing.traceability.wizard.form</field>
        <field name="model">pricing.traceability.wizard</field>
        <field name="arch" type="xml">
            <form string="Traçabilité du Calcul Tarifaire">
                <group string="Contexte">
                    <group>
                        <field name="sale_line_id"/>
                        <field name="product_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="order_date"/>
                        <field name="quantity"/>
                    </group>
                </group>

                <separator string="Détermination du Prix"/>
                <group>
                    <group string="Tarif">
                        <field name="pricing_rule_code"/>
                        <field name="pricing_rule_name"/>
                        <field name="price_type"/>
                        <field name="promotion_code"/>
                    </group>
                </group>

                <footer>
                    <button string="Fermer" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
