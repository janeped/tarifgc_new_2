<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_pricing_traceability_tree" model="ir.ui.view">
        <field name="name">pricing.traceability.list</field>
        <field name="model">pricing.traceability</field>
        <field name="arch" type="xml">
            <list string="Traçabilité des Prix">
                <field name="date"/>
                <field name="user_id"/>
                <field name="order_line_id"/>
                <field name="rule_applied"/>
                <field name="final_price"/>
            </list>
        </field>
    </record>

    <record id="action_pricing_traceability" model="ir.actions.act_window">
        <field name="name">Traçabilité des Prix</field>
        <field name="res_model">pricing.traceability</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
