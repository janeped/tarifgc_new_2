<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_sale_order_line_analysis_tree" model="ir.ui.view">
        <field name="name">sale.order.line.analysis.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Analyse des Ventes">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="price_unit"/>
                <field name="discount"/>
                <field name="price_subtotal"/>
                <field name="price_total"/>
            </list>
        </field>
    </record>

    <record id="action_sale_order_line_analysis" model="ir.actions.act_window">
        <field name="name">Analyse des Ventes</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
