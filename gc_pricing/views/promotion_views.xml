<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pricing_promotion_list" model="ir.ui.view">
        <field name="name">pricing.promotion.list</field>
        <field name="model">pricing.promotion</field>
        <field name="arch" type="xml">
            <list string="Promotions">
                <field name="code"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pricing_promotion_form" model="ir.ui.view">
        <field name="name">pricing.promotion.form</field>
        <field name="model">pricing.promotion</field>
        <field name="arch" type="xml">
            <form string="Promotion Commerciale">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" placeholder="ex: OLIM, BR, RPCREARE..."/></h1>
                        <field name="name" placeholder="Nom de la promotion"/>
                    </div>
                    <group>
                        <group string="Période">
                            <field name="date_start"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pricing_promotion" model="ir.actions.act_window">
        <field name="name">Promotions</field>
        <field name="res_model">pricing.promotion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
