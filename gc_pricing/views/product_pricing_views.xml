<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groupes de Tarification Produit -->
    <record id="view_product_pricing_group_list" model="ir.ui.view">
        <field name="name">product.pricing.group.list</field>
        <field name="model">product.pricing.group</field>
        <field name="arch" type="xml">
            <list string="Groupes de Tarification Produit">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_product_pricing_group_form" model="ir.ui.view">
        <field name="name">product.pricing.group.form</field>
        <field name="model">product.pricing.group</field>
        <field name="arch" type="xml">
            <form string="Groupe de Tarification Produit">
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code"/></h1>
                        <label for="name"/>
                        <field name="name" placeholder="Nom du groupe"/>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2" placeholder="Gamme concernée par ce groupe de tarification..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_pricing_group" model="ir.actions.act_window">
        <field name="name">Groupes de Tarification</field>
        <field name="res_model">product.pricing.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Classes de Remise Exceptionnelle -->
    <record id="view_product_discount_exceptional_list" model="ir.ui.view">
        <field name="name">product.discount.exceptional.list</field>
        <field name="model">product.discount.exceptional</field>
        <field name="arch" type="xml">
            <list string="Classes de Remise Exceptionnelle">
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_product_discount_exceptional_form" model="ir.ui.view">
        <field name="name">product.discount.exceptional.form</field>
        <field name="model">product.discount.exceptional</field>
        <field name="arch" type="xml">
            <form string="Classe de Remise Exceptionnelle">
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code"/></h1>
                        <label for="name"/>
                        <field name="name" placeholder="Nom de la classe"/>
                    </div>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="default_discount_rule_ids" widget="many2many_tags" placeholder="Remises appliquées par défaut"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_discount_exceptional" model="ir.actions.act_window">
        <field name="name">Classes de Remise Exceptionnelle</field>
        <field name="res_model">product.discount.exceptional</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Familles Promotionnelles -->
    <record id="view_product_promotional_family_list" model="ir.ui.view">
        <field name="name">product.promotional.family.list</field>
        <field name="model">product.promotional.family</field>
        <field name="arch" type="xml">
            <list string="Familles Promotionnelles">
                <field name="code"/>
                <field name="name"/>
                <field name="promotional_code"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_product_promotional_family_form" model="ir.ui.view">
        <field name="name">product.promotional.family.form</field>
        <field name="model">product.promotional.family</field>
        <field name="arch" type="xml">
            <form string="Famille Promotionnelle">
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code"/></h1>
                        <label for="name"/>
                        <field name="name" placeholder="Nom de la famille"/>
                    </div>
                    <group>
                        <group>
                            <field name="promotional_code"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_promotional_family" model="ir.actions.act_window">
        <field name="name">Familles Promotionnelles</field>
        <field name="res_model">product.promotional.family</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
