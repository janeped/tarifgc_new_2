<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form Extension -->
    <record id="view_product_template_form_pricing_extension" model="ir.ui.view">
        <field name="name">product.template.form.pricing.extension</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <div>
                    <field name="product_pricing_group_ids" widget="many2many_tags" placeholder="Groupes de Tarification"/>
                    <field name="product_exceptional_discount_class_id"/>
                    <field name="product_promotional_family_id"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
