<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Onglet Tarification dans la fiche produit -->
    <record id="view_product_template_form_pricing_inherit" model="ir.ui.view">
        <field name="name">product.template.form.pricing.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Tarification" name="pricing_tab" groups="sales_team.group_sale_manager">
                    <group>
                        <group string="Segmentation Produit">
                            <field name="product_pricing_group_ids" widget="many2many_tags"/>
                            <field name="product_exceptional_discount_class_id"/>
                            <field name="product_promotional_family_id"/>
                        </group>
                        <group string="Type de Prix">
                            <field name="price_type_default"/>
                            <field name="price_decimal_precision"/>
                        </group>
                    </group>
                    <separator string="Pilotage par Référence"/>
                    <group>
                        <field name="use_reference_pricing"/>
                        <field name="reference_product_id" attrs="{'invisible': [('use_reference_pricing', '=', False)], 'required': [('use_reference_pricing', '=', True)]}"/>
                    </group>
                    <separator string="Exclusions"/>
                    <group>
                        <group>
                            <field name="exclude_from_all_discounts"/>
                            <field name="exclude_from_promotions"/>
                        </group>
                    </group>
                    <separator string="Kits / Décompositions"/>
                    <group>
                        <group>
                            <field name="is_kit_composite"/>
                            <field name="kit_valuation_method" attrs="{'invisible': [('is_kit_composite', '=', False)]}"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>