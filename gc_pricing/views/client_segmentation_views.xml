<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groupes de Clients -->
    <record id="view_client_segmentation_group_tree" model="ir.ui.view">
        <field name="name">client.segmentation.group.tree</field>
        <field name="model">client.segmentation.group</field>
        <field name="arch" type="xml">
            <tree string="Groupes de Clients">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_client_segmentation_group_form" model="ir.ui.view">
        <field name="name">client.segmentation.group.form</field>
        <field name="model">client.segmentation.group</field>
        <field name="arch" type="xml">
            <form string="Groupe de Clients">
                <sheet>
                    <div class="oe_title">
                        <label for="code" class="oe_edit_only"/><h1><field name="code"/></h1>
                        <label for="name" class="oe_edit_only"/><field name="name"/>
                    </div>
                    <group>
                        <field name="type"/>
                        <field name="active"/>
                        <field name="parent_id"/>
                    </group>
                    <group string="Description"><field name="description" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_client_segmentation_group" model="ir.actions.act_window">
        <field name="name">Groupes de Clients</field>
        <field name="res_model">client.segmentation.group</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Familles Tarifaires Clients -->
    <record id="view_client_tariff_family_tree" model="ir.ui.view">
        <field name="name">client.tariff.family.tree</field>
        <field name="model">client.tariff.family</field>
        <field name="arch" type="xml">
            <tree string="Familles Tarifaires Clients">
                <field name="code"/><field name="name"/><field name="is_exceptional"/><field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_client_tariff_family" model="ir.actions.act_window">
        <field name="name">Familles Tarifaires Clients</field>
        <field name="res_model">client.tariff.family</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Classes de Remises Exceptionnelles -->
    <record id="view_client_discount_exceptional_tree" model="ir.ui.view">
        <field name="name">client.discount.exceptional.tree</field>
        <field name="model">client.discount.exceptional</field>
        <field name="arch" type="xml">
            <tree string="Classes de Remises Exceptionnelles">
                <field name="code"/><field name="name"/><field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_client_discount_exceptional" model="ir.actions.act_window">
        <field name="name">Classes de Remises Clients</field>
        <field name="res_model">client.discount.exceptional</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>