<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groupes de Clients -->
    <record id="view_client_segmentation_group_list" model="ir.ui.view">
        <field name="name">client.segmentation.group.list</field>
        <field name="model">client.segmentation.group</field>
        <field name="arch" type="xml">
            <list string="Groupes de Clients">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_client_segmentation_group_form" model="ir.ui.view">
        <field name="name">client.segmentation.group.form</field>
        <field name="model">client.segmentation.group</field>
        <field name="arch" type="xml">
            <form string="Groupe de Clients">
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code"/></h1>
                        <label for="name"/>
                        <field name="name" placeholder="ex: CREAREF, CODIPA, CULTURA..."/>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2" placeholder="Description du groupe de clients..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_client_segmentation_group" model="ir.actions.act_window">
        <field name="name">Groupes de Clients</field>
        <field name="res_model">client.segmentation.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un premier groupe de clients</p>
            <p>Codipa, Crearef, Cultura...</p>
        </field>
    </record>
</odoo>
