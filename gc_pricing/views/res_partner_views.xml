<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Form Extension -->
    <record id="view_partner_form_pricing_extension" model="ir.ui.view">
        <field name="name">res.partner.form.pricing.extension</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Segmentation Tarifaire">
                    <group>
                        <field name="customer_segmentation_group_ids" widget="many2many_tags"/>
                        <field name="customer_tariff_family_id"/>
                        <field name="customer_exceptional_discount_class_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
