<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groupe Lecteur Tarification (base de la hiérarchie) -->
    <record id="group_pricing_viewer" model="res.groups">
        <field name="name">Lecteur Tarification</field>
        <field name="comment">Consultation seule des règles tarifaires, promotions, exclusions. Accès aux wizards de simulation et traçabilité.</field>
    </record>

    <!-- Groupe Gestionnaire Tarification (hérite de Viewer) -->
    <record id="group_pricing_manager" model="res.groups">
        <field name="name">Gestionnaire Tarification</field>
        <field name="implied_ids" eval="[(4, ref('group_pricing_viewer'))]"/>
        <field name="comment">Création et modification des règles, consultations, simulations. Pas de suppression ni d'import masse.</field>
    </record>

    <!-- Groupe Administrateur Tarification (hérite de Manager → donc aussi de Viewer) -->
    <record id="group_pricing_admin" model="res.groups">
        <field name="name">Administrateur Tarification</field>
        <field name="implied_ids" eval="[(4, ref('group_pricing_manager'))]"/>
        <field name="comment">Accès complet : création, modification, suppression de toutes les règles tarifaires, import masse, configuration.</field>
    </record>
</odoo>